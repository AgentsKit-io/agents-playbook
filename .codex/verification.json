    "docs": true
  },
  "checks": [
    { "id": "harness-tests", "category": "logic", "command": "pnpm harness:test", "evidence": "structured", "timeoutMs": 120000 },
    { "id": "harness-cli", "category": "cli", "execution": "real", "command": "pnpm harness:cli", "evidence": "structured", "timeoutMs": 120000 },
    { "id": "harness-consumer", "category": "cli", "execution": "real", "command": "node scripts/verify-harness-consumer.mjs", "evidence": "structured", "timeoutMs": 180000 },
