  "benchmark": { "suiteId": "agentskit-harness-phase-4", "taskId": "harness-process-sandbox", "mode": "harness" },
  "contract": {
    "intent": "Implement and validate the portable AgentsKit Harness package and its CLI.",
    "scope": {
      "inScope": ["packages/harness", "scripts/verify-harness-package.mjs", "scripts/verify-harness-consumer.mjs", "scripts/verify-harness-cli-flow.mjs", "scripts/verify-harness-benchmark.mjs", "benchmarks/harness-phase-4.json", ".codex/verification.json"],
      "outOfScope": ["marketing redesign", "provider-specific agent adapters", "automatic git push or PR creation"]
    },
    "ambiguities": [],
    "outcomes": [
      { "id": "package", "statement": "The typed harness library builds, exposes a usable CLI lifecycle, and installs correctly in a clean consumer project.", "checks": ["harness-tests", "harness-build", "harness-cli", "harness-cli-flow", "harness-consumer"] },
      { "id": "protocol", "statement": "The contract, state machine, evidence, stale detection, and approval protocol are enforced.", "checks": ["harness-contract"] },
      { "id": "extensibility", "statement": "The public harness API exposes a typed, dependency-aware plugin lifecycle with deterministic cleanup and contribution isolation.", "checks": ["harness-extensibility"] },
      { "id": "event-log", "statement": "Every verification run records an append-only lifecycle event log that is ordered and bound to the run source and contract.", "checks": ["harness-event-log"] },
      { "id": "profiles", "statement": "Named verification profiles compose deterministic, validated overlays without changing the kernel guarantees.", "checks": ["harness-profiles"] },
      { "id": "context", "statement": "Optional context providers expose a typed, provenance-bearing seam suitable for Doc Bridge and Playbook integrations.", "checks": ["harness-context"] },
      { "id": "doc-bridge-adapter", "statement": "The optional Doc Bridge adapter resolves real indexed knowledge into deterministic provenance-bearing context snapshots.", "checks": ["harness-doc-bridge"] },
      { "id": "context-binding", "statement": "A resolved context snapshot is frozen into the planned run with a reproducible context hash and lifecycle event.", "checks": ["harness-context-binding"] },
      { "id": "context-cli", "statement": "The common CLI protocol can resolve a Doc Bridge snapshot and attach it to a planned run from a portable JSON file.", "checks": ["harness-context-cli"] },
      { "id": "context-integrity", "statement": "Imported context snapshots reject tampering when their semantic contents no longer match their cryptographic snapshot hash.", "checks": ["harness-context-integrity"] },
      { "id": "metrics", "statement": "The public CLI and API aggregate reproducible historical run metrics for measuring harness improvement.", "checks": ["harness-metrics", "harness-benchmark"] },
      { "id": "agent-protocol", "statement": "The public API records a correlated, privacy-preserving agent session and guarded tool lifecycle during implementation.", "checks": ["harness-agent-protocol"] },
      { "id": "policy-gate", "statement": "Every recorded tool action receives a deterministic allow/block decision before it can enter the pending execution lifecycle.", "checks": ["harness-policy-gate"] },
      { "id": "runtime", "statement": "Allowed tool actions execute through a bounded runtime and produce structured hashed completion or failure evidence.", "checks": ["harness-runtime"] },
      { "id": "process-runtime", "statement": "Allowed actions can execute through a shell-free child-process runtime with timeout, output limits, and structured recovery evidence.", "checks": ["harness-process-runtime"] },
      { "id": "docs", "statement": "The Playbook and package distribution metadata document the portable protocol and contribution workflow.", "checks": ["playbook-docs", "package-docs"] }
    ]
  },
  "surfaces": {
