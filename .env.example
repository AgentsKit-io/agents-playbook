NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Analytics is opt-in so a stale/missing PostHog project never degrades the public experience.
NEXT_PUBLIC_POSTHOG_ENABLED=false
# Ask Playbook backend for questions the local corpus cannot answer. No default:
# leave unset to keep local answers only (backend questions show a "not configured" error).
# NEXT_PUBLIC_ASK_ENDPOINT=https://<your-ask-host>/v1/ask
