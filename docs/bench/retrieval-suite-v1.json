{
  "evalFormatVersion": "2026-04",
  "name": "agents-playbook-retrieval-v1",
  "description": "Golden retrieval queries for the Agents Playbook repository: exported symbols, file paths, natural-language questions answered by a maintained guide, and ownership routing. A case passes when one of its expected targets appears in the ranking; a target matches a result by entity id or by repository path. The documentation is English only, so every case is English.",
  "tags": [
    "retrieval",
    "doc-bridge",
    "deterministic"
  ],
  "cases": [
    {
      "id": "symbol-read-doc-sources",
      "input": "readDocSources",
      "expected": {
        "regex": {
          "body": "lib/doc-sources\\.ts"
        }
      },
      "metadata": {
        "expectedTargets": [
          "lib/doc-sources.ts"
        ],
        "lang": "en",
        "kind": "symbol"
      }
    },
