--- /dev/null
+++ b/fromFile.js
@@ -0,0 +1,22 @@
+"use strict";
+
+const fs = require("node:fs");
+const path = require("node:path");
+const { imageSize } = require("./dist/index.js");
+
+const MAX_INPUT_SIZE = 512 * 1024;
+
+async function imageSizeFromFile(filePath) {
+  const handle = await fs.promises.open(path.resolve(filePath), "r");
+  try {
+    const { size } = await handle.stat();
+    if (size <= 0) throw new Error("Empty file");
+    const input = new Uint8Array(Math.min(size, MAX_INPUT_SIZE));
+    await handle.read(input, 0, input.length, 0);
+    return imageSize(input);
+  } finally {
+    await handle.close();
+  }
+}
+
+exports.imageSizeFromFile = imageSizeFromFile;
