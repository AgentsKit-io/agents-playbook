{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare Workers deployment via OpenNext (@opennextjs/cloudflare).
  // Build + deploy: pnpm cf:deploy. Vercel keeps using `next build` unchanged.
  "name": "agents-playbook",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    // Self-reference used by OpenNext for ISR revalidation.
    { "binding": "WORKER_SELF_REFERENCE", "service": "agents-playbook" }
  ],
  "kv_namespaces": [
    // ISR / route-handler revalidate cache (api/ecosystem-stars revalidates every 6 h).
    { "binding": "NEXT_INC_CACHE_KV", "id": "7d78c01fc1ed4e0abb51ee05ad07fd9c" }
  ],
  "observability": { "enabled": true }
}
